  "advanced_coding": [
    {
      "id": "c1",
      "type": "coding",
      "title": "Merge Sort Implementation",
      "prompt": "Implement mergeSort(arr) that returns a new sorted array using the merge sort algorithm.",
      "functionName": "mergeSort",
      "starterCode": "function mergeSort(arr){\n  if(!Array.isArray(arr)) return [];\n  if(arr.length <= 1) return arr;\n  const mid = Math.floor(arr.length/2);\n  const left = mergeSort(arr.slice(0, mid));\n  const right = mergeSort(arr.slice(mid));\n  return merge(left, right);\n}\nfunction merge(a,b){\n  const out=[]; let i=0,j=0;\n  while(i<a.length && j<b.length){\n    if(a[i] <= b[j]) out.push(a[i++]); else out.push(b[j++]);\n  }\n  while(i<a.length) out.push(a[i++]);\n  while(j<b.length) out.push(b[j++]);\n  return out;\n}\n",
      "tests": [
        {
          "args": [[3, 1, 2]],
          "expected": [1, 2, 3],
          "desc": "Sort small array"
        },
        {
          "args": [[5, 4, 3, 2, 1]],
          "expected": [1, 2, 3, 4, 5],
          "desc": "Reverse order"
        },
        { "args": [[1]], "expected": [1], "desc": "Single element" },
        { "args": [[]], "expected": [], "desc": "Empty array" },
        { "args": [[2, 2, 1]], "expected": [1, 2, 2], "desc": "Duplicates" }
      ]
    },
    {
      "id": "c2",
      "type": "coding",
      "title": "Palindrome Check",
      "prompt": "Implement isPalindrome(str) that returns true if str is a palindrome (case insensitive, alphanumeric only).",
      "functionName": "isPalindrome",
      "starterCode": "function isPalindrome(str){\n  if(typeof str !== 'string') return false;\n  const cleaned = str.replace(/[^a-zA-Z0-9]/g,'').toLowerCase();\n  let i=0,j=cleaned.length-1;\n  while(i<j){\n    if(cleaned[i++]!==cleaned[j--]) return false;\n  }\n  return true;\n}\n",
      "tests": [
        { "args": ["racecar"], "expected": true, "desc": "Simple palindrome" },
        { "args": ["Race CAR"], "expected": true, "desc": "Case + spaces" },
        { "args": ["hello"], "expected": false, "desc": "Non-palindrome" },
        { "args": [""], "expected": true, "desc": "Empty string" },
        {
          "args": ["A man, a plan, a canal: Panama"],
          "expected": true,
          "desc": "Classic phrase"
        }
      ]
    },
    {
      "id": "c3",
      "type": "coding",
      "title": "Array Two Sum",
      "prompt": "Implement twoSum(nums,target) returning indices of two numbers that add to target or [] if none.",
      "functionName": "twoSum",
      "starterCode": "function twoSum(nums, target){\n  const map = new Map();\n  for(let i=0;i<nums.length;i++){\n    const need = target - nums[i];\n    if(map.has(need)) return [map.get(need), i];\n    map.set(nums[i], i);\n  }\n  return [];\n}\n",
      "tests": [
        {
          "args": [[2, 7, 11, 15], 9],
          "expected": [0, 1],
          "desc": "Basic example"
        },
        { "args": [[3, 2, 4], 6], "expected": [1, 2], "desc": "Middle pair" },
        { "args": [[3, 3], 6], "expected": [0, 1], "desc": "Duplicate values" },
        { "args": [[1, 2, 3], 7], "expected": [], "desc": "No solution" }
      ]
    }
  ]
}
